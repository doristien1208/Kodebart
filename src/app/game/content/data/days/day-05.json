      "lines": [
        "樓下那台咖啡機修好了。今天終於不是溫水。"
      ],
      "replyPrompt": {
        "id": "prompt.day5.m1-coffee",
        "availableThrough": "day.05",
        "choices": [
          {
            "id": "join",
            "text": "等我這批送完一起下去。",
            "responses": [
