  "mail": {
    "packId": "mail.m1-workday",
    "sender": {
      "id": "sender.data-desk",
      "name": "資料作業窗口"
    },
    "templates": {
      "version": {
        "subject": "黃品蓉補件：本次引用版本",
        "lines": [
          "已收到本次送件。所引用的來源版本請見附件。",
          "原登記表與補件的人員編號不同，窗口仍在確認。這封信只確認收件，尚未確認應採用的編號。"
        ]
      },
      "wrong-attachment": {
        "subject": "附件關聯需修正：0314",
        "lines": [
          "本次送件引用了另一個對象的附件，無法作為這筆資料的回覆依據。",
          "請從本信附件開啟最新修訂。原送件版本留存，不會被覆蓋。"
        ]
      },
      "window-only": {
        "subject": "收件回條：服務窗口小批次",
        "lines": [
          "窗口已收到本批資料，送件副本見附件。",
          "引用的電子回條只確認窗口收件。未附本人回覆的資料，來源狀態仍可在批次副本中查閱。"
        ]
      },
      "awaiting": {
        "subject": "待補清單：服務窗口小批次",
        "lines": [
          "以下項目仍等待回覆附件，本次交接保留原缺漏。",
          "請保留本批紀錄；附件抵達後由最新待補項目續處理，不需要重新建立整批。"
        ]
      },
      "paper": {
        "subject": "紙本交接：補件進度",
        "lines": [
          "目前取得電子收件回條，實物簽收資料尚未補齊。",
          "原交接資料與本次引用附件均留在信中。請不要以電子收件時間取代實物簽收時間。"
        ]
      },
      "batch": {
        "subject": "補充批次：交付結果",
        "lines": [
          "補充批次已完成流程處理，逐列結果與來源見附件。",
          "送件筆數、已附本人回覆與待補項目分別列示，不能互相取代。"
        ]
      }
    },
